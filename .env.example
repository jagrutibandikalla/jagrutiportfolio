# Cloudinary Configuration (safe to expose — these are public client-side keys)
# Get these from: https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key_here

# ─── SERVER-SIDE ONLY — NEVER expose to browser or commit real value ──────────
# This MUST remain in .env (gitignored) and NEVER go into VITE_ variables
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Firebase web config is public by design — these are safe to expose in the browser.
# Your actual values are hardcoded in src/lib/firebase.ts
# If you move Firebase config to env vars in the future, use these names:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ─── Vercel Environment Variables Setup ───────────────────────────────────────
# Add the following in your Vercel project → Settings → Environment Variables:
# VITE_CLOUDINARY_CLOUD_NAME = (your real Cloudinary cloud name)
# VITE_CLOUDINARY_UPLOAD_PRESET = (your real upload preset name)
#
# Never add CLOUDINARY_API_SECRET to Vercel client-visible vars.
